{
  "name": "deltix-server",
  "version": "0.6.14",
  "private": true,
  "license": "BUSL-1.1",
  "type": "module",
  "description": "Deltix Enterprise Control Plane (Bun + HonoJS). Source-available under the Business Source License 1.1.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run src/index.ts",
    "build": "bun build ./src/index.ts --compile --outfile dist/deltix-server",
    "build:css": "bunx @tailwindcss/cli -i src/styles/admin.css -o src/contexts/admin-ui/assets/vendor/tailwind.css --content 'src/contexts/admin-ui/assets/**/*.{html,js}' --minify",
    "watch:css": "bunx @tailwindcss/cli -i src/styles/admin.css -o src/contexts/admin-ui/assets/vendor/tailwind.css --content 'src/contexts/admin-ui/assets/**/*.{html,js}' --watch",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "bun test",
    "test:unit": "bun test tests/unit",
    "test:integration": "bun test tests/integration",
    "test:smoke": "bun test --timeout=90000 tests/smoke",
    "tls:server-cert": "bun run scripts/generate-server-tls-cert.ts",
    "build:tls-cert-tool": "bun build ./scripts/generate-server-tls-cert.ts --compile --outfile dist/deltix-gen-cert"
  },
  "dependencies": {
    "@deltix/addon-sdk": "workspace:*",
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/proto-loader": "^0.8.1",
    "@libsql/client": "0.17.4",
    "hono": "4.13.5",
    "jose": "6.2.10",
    "pino": "10.3.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bun": "1.4.0",
    "bun-types": "^1.4.0",
    "pino-pretty": "13.1.3",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "trustedDependencies": [
    "protobufjs"
  ]
}
