{
  "name": "deltix-server",
  "version": "0.2.4",
  "private": true,
  "license": "BUSL-1.1",
  "type": "module",
  "description": "Deltix Enterprise Control Plane (Bun + HonoJS). Source-available under the Business Source License 1.1.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run src/index.ts",
    "build": "bun build ./src/index.ts --compile --outfile dist/deltix-server",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "bun test",
    "test:unit": "bun test tests/unit",
    "test:integration": "bun test tests/integration",
    "test:smoke": "bun test tests/smoke"
  },
  "dependencies": {
    "@deltix/addon-sdk": "workspace:*",
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/proto-loader": "^0.8.1",
    "@libsql/client": "0.17.4",
    "hono": "4.13.5",
    "jose": "6.2.10",
    "pino": "10.3.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@types/bun": "1.4.0",
    "bun-types": "^1.4.0",
    "pino-pretty": "13.1.3"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "trustedDependencies": [
    "protobufjs"
  ]
}
