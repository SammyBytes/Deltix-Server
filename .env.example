# Deltix-Server environment configuration
# Copy to .env for local development. NEVER commit a real .env file.
# All values below are validated at boot time (see src/shared/env.ts) — the
# process fails fast with a clear error if a required variable is missing or malformed.

# --- Licensing (Fase 1) ---
# Ed25519 public key used to verify the signed license key (PEM SPKI, base64, or raw base64url —
# see src/contexts/licensing/ed25519.ts for the accepted encodings). NEVER hardcode this in source.
DELTIX_LICENSE_PUBLIC_KEY=

# Signed license key blob: base64url(payload_json).base64url(signature)
DELTIX_LICENSE_KEY=

# Path to the local Dolt data repository used as the immutable commit log (dolt_log)
# for anti-tamper / anti-clock-rollback verification. Must be a directory already
# initialized with `dolt init`.
DELTIX_DOLT_REPO_PATH=/var/lib/deltix/dolt-data

# Allowed clock-skew tolerance (milliseconds) before a rollback is considered tampering.
DELTIX_CLOCK_TOLERANCE_MS=5000

# --- Logging ---
# One of: trace | debug | info | warn | error | fatal
LOG_LEVEL=info
# true -> human-readable pretty output (development). false/unset -> structured JSON (production).
LOG_PRETTY=true

# --- Auth / REST Control Plane (Fase 2) ---
# Ed25519 private key (PKCS8 PEM) used to sign access tokens (JWT, EdDSA algorithm).
# NEVER commit a real value. Rotate via secret manager / OS env injection only.
DELTIX_JWT_PRIVATE_KEY=

# Ed25519 public key (SPKI PEM) used to verify access tokens. Safe to distribute to
# trusted verifiers, but still should not be hardcoded in source.
DELTIX_JWT_PUBLIC_KEY=

# JSON array of local user accounts (1-3 seats, per the local-auth tier limit before
# an Enterprise LDAP/OIDC add-on is required). Each entry: { "username": string, "passwordHash": string }.
# Generate passwordHash with Bun.password.hash() (argon2id) — never store plaintext passwords.
DELTIX_LOCAL_USERS=[{"username":"admin","passwordHash":"REPLACE_WITH_ARGON2ID_HASH"}]

# Filesystem path to the libSQL database file backing session state (sliding-window
# expiration, not an absolute TTL). Directory must be writable by the server process.
DELTIX_SESSION_DB_PATH=/var/lib/deltix/sessions.db

# Access token lifetime in seconds (short-lived; sessions are refreshed via keep-alive).
DELTIX_ACCESS_TOKEN_TTL_SECONDS=900

# Session inactivity window in seconds — session expires if not kept alive within this
# many seconds, regardless of when it was originally created (sliding window, not absolute TTL).
DELTIX_SESSION_TTL_SECONDS=120

# --- Server (placeholders for future phases) ---
NODE_ENV=development
HTTP_PORT=9090
GRPC_DOLT_PORT=50051
