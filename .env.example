# Deltix-Server environment configuration
# Copy to .env for local development. NEVER commit a real .env file.
# All values below are validated at boot time (see src/shared/env.ts) — the
# process fails fast with a clear error if a required variable is missing or malformed.

# --- Licensing (Fase 1) ---
# Ed25519 public key used to verify the signed license key (PEM SPKI, base64, or raw base64url —
# see src/contexts/licensing/ed25519.ts for the accepted encodings). NEVER hardcode this in source.
DELTIX_LICENSE_PUBLIC_KEY=

# Signed license key blob: base64url(payload_json).base64url(signature)
DELTIX_LICENSE_KEY=

# Path to the local Dolt data repository used as the immutable commit log (dolt_log)
# for anti-tamper / anti-clock-rollback verification. Must be a directory already
# initialized with `dolt init`.
DELTIX_DOLT_REPO_PATH=/var/lib/deltix/dolt-data

# Allowed clock-skew tolerance (milliseconds) before a rollback is considered tampering.
DELTIX_CLOCK_TOLERANCE_MS=5000

# --- Logging ---
# One of: trace | debug | info | warn | error | fatal
LOG_LEVEL=info
# true -> human-readable pretty output (development). false/unset -> structured JSON (production).
LOG_PRETTY=true

# --- Auth / REST Control Plane (Fase 2) ---
# Ed25519 private key (PKCS8 PEM) used to sign access tokens (JWT, EdDSA algorithm).
# NEVER commit a real value. Rotate via secret manager / OS env injection only.
DELTIX_JWT_PRIVATE_KEY=

# Ed25519 public key (SPKI PEM) used to verify access tokens. Safe to distribute to
# trusted verifiers, but still should not be hardcoded in source.
DELTIX_JWT_PUBLIC_KEY=

# JSON array of local user accounts (1-3 seats, per the local-auth tier limit before
# an Enterprise LDAP/OIDC add-on is required). Each entry: { "username": string, "passwordHash": string }.
# Generate passwordHash with Bun.password.hash() (argon2id) — never store plaintext passwords.
DELTIX_LOCAL_USERS=[{"username":"admin","passwordHash":"REPLACE_WITH_ARGON2ID_HASH"}]

# Filesystem path to the libSQL database file backing session state (sliding-window
# expiration, not an absolute TTL). Directory must be writable by the server process.
DELTIX_SESSION_DB_PATH=/var/lib/deltix/sessions.db

# Access token lifetime in seconds (short-lived; sessions are refreshed via keep-alive).
DELTIX_ACCESS_TOKEN_TTL_SECONDS=900

# Session inactivity window in seconds — session expires if not kept alive within this
# many seconds, regardless of when it was originally created (sliding window, not absolute TTL).
DELTIX_SESSION_TTL_SECONDS=120

# Comma-separated exact-origin allow-list for cross-origin browser requests (CORS).
# Empty by default: the CLI client talks server-to-server (no browser origin involved),
# so nothing needs to be allowed until a browser-based client (e.g. Admin Web UI) is
# served from a different origin/port. NEVER use "*" for an authenticated API.
DELTIX_CORS_ALLOWED_ORIGINS=

# --- Admin Web UI (optional, disabled by default) ---
# Serves a minimal static login/session page at /admin using the SAME auth
# endpoints as the CLI. Disabled by default to minimize attack surface for
# headless/CI-driven deployments.
DELTIX_ADMIN_UI_ENABLED=false

# --- Ephemeral Transfer Tickets (Fase 3) ---
# Filesystem path to the libSQL database backing ephemeral gRPC transfer
# tickets. Separate from the session DB above — tickets and sessions are
# deliberately different credentials with different lifetimes/purposes.
DELTIX_TICKET_DB_PATH=/var/lib/deltix/transfer-tickets.db

# Ticket TTL in seconds (sliding window, renewed by the client's heartbeat
# every ~30s during an active transfer). Do NOT raise this casually — it
# bounds how long a leaked/stolen ticket remains exploitable.
DELTIX_TICKET_TTL_SECONDS=120

# --- SSD Staging -> NAS Sync Pipeline (Fase 3 continued) ---
# Filesystem path to the libSQL database backing transfer-job bookkeeping
# (staged -> syncing -> synced | sync_failed -> dead_letter). Separate from
# both the session and ticket DBs above.
DELTIX_TRANSFER_JOB_DB_PATH=/var/lib/deltix/transfer-jobs.db

# Destination for the "NAS" a job gets promoted to. No physical NAS is
# available in dev, so this is a plain local folder treated exactly like a
# real NAS mount (copy + checksum verify + atomic rename) — swap this for a
# real NAS-backed adapter in production without touching NasSyncService.
DELTIX_NAS_SIM_PATH=/var/lib/deltix/nas-sim

# Exponential backoff (ms) applied between automatic retry attempts for a
# failed sync, capped at the max. Never remove the cap — unbounded backoff
# delays turn transient NAS blips into de-facto permanent failures.
DELTIX_NAS_SYNC_BACKOFF_BASE_MS=1000
DELTIX_NAS_SYNC_BACKOFF_MAX_MS=60000

# How often (ms) the background worker polls for newly-eligible jobs.
DELTIX_NAS_SYNC_POLL_INTERVAL_MS=5000

# Max automatic retry attempts before a job is escalated to dead_letter and
# requires manual operator action (via the /api/v1/storage/transfer-jobs/
# dead-letter endpoints) — data is never silently dropped.
DELTIX_TRANSFER_JOB_MAX_RETRIES=5

# --- gRPC Transfer Engine (Fase 3 continued): Push/Pull/Heartbeat ---
# TCP port the gRPC transfer server listens on. ALWAYS TLS — there is no
# plaintext code path, so the cert/key paths below are mandatory.
DELTIX_GRPC_PORT=50051

# PEM cert chain / private key for the gRPC server's TLS credentials.
# For local dev, generate a self-signed pair with:
#   bun run scripts/generate-dev-tls-certs.ts
# which writes ./certs/dev/server.crt and ./certs/dev/server.key.
# Production deployments MUST supply their own CA-signed certificate —
# the server never generates or manages certificates itself.
DELTIX_GRPC_TLS_CERT_PATH=./certs/dev/server.crt
DELTIX_GRPC_TLS_KEY_PATH=./certs/dev/server.key

# Filesystem path where in-flight Push uploads are staged (SSD) before
# being promoted into the NAS sync pipeline above.
DELTIX_STAGING_ROOT_PATH=/var/lib/deltix/staging

# --- Add-on system (Fase 4) ---
# TOFU (Trust-On-First-Use) trust store for community addon author keys.
DELTIX_ADDON_TRUST_DB_PATH=./data/addon-trust.db
# Comma-separated local filesystem directories to discover addon packages
# from ("Bring Your Own File Path" — no marketplace/registry in Fase 4).
DELTIX_ADDON_PATHS=
# Comma-separated official addon names that are always free, regardless of
# the license payload's `addons.official` list.
DELTIX_ADDON_FREE_OFFICIAL=
# Consecutive runtime failures before an addon route handler is disabled
# in-memory until the process restarts (circuit breaker).
DELTIX_ADDON_MAX_CONSECUTIVE_FAILURES=5

# --- Server (placeholders for future phases) ---
NODE_ENV=development
HTTP_PORT=9090
